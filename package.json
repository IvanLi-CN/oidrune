{
  "name": "oidrune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && python3 scripts/validate-built-brand-assets.py",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "quality": "bun run check && bun run typecheck && bun run test:unit && bun run test:integration && bun run build && bun run test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "hono": "4.13.7",
    "jose": "6.2.12",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260910.1",
    "@playwright/test": "1.63.0",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.1.12",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
