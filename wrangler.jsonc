{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oidrune",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/api/*", "/console", "/console/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oidrune",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "oidrune-delivery" },
      { "binding": "DELIVERY_DLQ", "queue": "oidrune-delivery-dlq" }
    ],
    "consumers": [
      {
        "queue": "oidrune-delivery",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "oidrune-delivery-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "REPLAY_GUARD", "class_name": "ReplayGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReplayGuard"] }],
  "triggers": { "crons": ["17 3 * * *"] }
}
